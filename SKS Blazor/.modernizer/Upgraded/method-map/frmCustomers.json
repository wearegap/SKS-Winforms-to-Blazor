      "methodBody": "\t\t{\n\t\t\tdcCustomers.ConnectionString = modMain.ConnectionString;\n\t\t\tNewMode = false;\n\t\t\tEditMode = false;\n\t\t\tCancellingMode = false;\n\t\t}\n",
