@page "/login"

<PageTitle>Login</PageTitle>

@* Entry point (decisions.md: "redirect unauthenticated users to /login"). Hosts the frmLogin port as a
   modal that cannot be dismissed without signing in; MainLayout redirects here while AppState.IsLoggedIn is false. *@

<div style="display:flex; height:100%; align-items:center; justify-content:center;">
    <MudPaper Elevation="3" Style="padding:32px; text-align:center; max-width:420px; width:100%;">
        <MudText Typo="Typo.h5" Class="mb-2">SKS Inventory Management</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Sign in to continue.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowLoginAsync" Disabled="_dialogOpen">
            Sign in
        </MudButton>
    </MudPaper>
</div>

@code {
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private AppState AppState { get; set; } = default!;

    /// <summary>Base-relative path to return to after signing in (set by the MainLayout guard).</summary>
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private bool _dialogOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ShowLoginAsync();
    }

    private async Task ShowLoginAsync()
    {
        if (AppState.IsLoggedIn)
        {
            GoBack();
            return;
        }

        _dialogOpen = true;
        StateHasChanged();
        var options = new DialogOptions
        {
            BackdropClick = false,
            CloseOnEscapeKey = false,
            CloseButton = false,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<LoginDialog>("Login", options);
        var result = await dialog.Result;
        _dialogOpen = false;

        if (result is { Canceled: false } && AppState.IsLoggedIn)
            GoBack();
        else
            StateHasChanged(); // cancelled: stay; the button reopens the dialog
    }

    private void GoBack()
    {
        // Only accept base-relative paths so the query string cannot redirect off-site.
        var target = string.IsNullOrWhiteSpace(ReturnUrl) || ReturnUrl.Contains("://") || ReturnUrl.StartsWith("//")
            ? string.Empty
            : ReturnUrl.TrimStart('/');
        NavigationManager.NavigateTo("/" + target);
    }
}
