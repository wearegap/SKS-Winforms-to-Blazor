@namespace SKS_Blazor.Pages.Splash

@* Port of frmSplash — splash screen dialog shown at application startup. *@
@* Legacy methods ported: frmSplash_Activated, Form_KeyPress, Timer1_Tick, Form_Closed. *@

<MudDialog @onkeydown="OnKeyPress" tabindex="0" Style="outline: none;">
    <TitleContent>
        <MudText Typo="Typo.h6">SKS Blazor</MudText>
    </TitleContent>
    <DialogContent>
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 360px; min-height: 200px; padding: 24px;">
            <MudImage Src="images/sks-logo.png" Alt="Salmon King Seafood" Width="120" Height="120" ObjectFit="ObjectFit.Contain" Class="mb-4" />
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">SKS Blazor</MudText>
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Color="Color.Secondary" Class="mb-2">Stock Keeping System</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Tertiary">Loading application...</MudText>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" Style="width: 100%;" />
        </div>
    </DialogContent>
</MudDialog>
