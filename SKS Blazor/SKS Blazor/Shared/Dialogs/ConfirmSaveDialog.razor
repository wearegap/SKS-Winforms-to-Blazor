@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="OnYes">
            Yes
        </MudButton>
        <MudButton Color="Color.Default"
                   Variant="Variant.Outlined"
                   OnClick="OnNo">
            No
        </MudButton>
        <MudButton Color="Color.Error"
                   Variant="Variant.Text"
                   OnClick="OnCancel">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>
